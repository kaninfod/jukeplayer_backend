# ============================================================================
# JUKEPLAYER BACKEND - RPi (dedicated device) environment
# ============================================================================
# PHASE 0 NOTE: until the configuration UI ships, this file carries the FULL
# configuration (same keys as the docker .env). It shrinks to the ~6 system
# keys below when the config store lands (Phase A) — the store takes over.
# Copy your working values from the current docker .env.

# === SYSTEM (these survive into the final config) ===
LOG_SERVER_HOST=192.168.68.102
LOG_SERVER_PORT=514
ENABLE_DOCS=false
# LOG_FILE=logs/jukebox.log
# CONFIG_FILE=data/config.json

# === SUBSONIC / GONIC (moves to the config UI in Phase A) ===
SUBSONIC_URL=http://192.168.68.102:4747
SUBSONIC_USER=
SUBSONIC_PASS=
SUBSONIC_CLIENT=JukeboxPi
SUBSONIC_API_VERSION=1.16.1
SUBSONIC_PROXY_BASIC_USER=
SUBSONIC_PROXY_BASIC_PASS=

# === SPEAKERS (moves to the config UI/store in Phase A/B) ===
PLAYBACK_DEVICES=living_room=chromecast,bedroom=chromecast,kitchen=chromecast,boom3=mpv
DEFAULT_CHROMECAST_DEVICE=Living Room
CHROMECAST_DEVICES=Living Room,Bedroom,Kitchen
CHROMECAST_FALLBACK_DEVICES=Bedroom,Kitchen
PLAYBACK_BACKEND=chromecast

# === MPV (moves to the config UI/store in Phase B) ===
MPV_BINARY=mpv
MPV_IPC_SOCKET=/tmp/jukebox-mpv.sock
MPV_DEVICE_NAME=BOOM3
MPV_LOG_FILE=/tmp/mpv-jukebox.log
MPV_MSG_LEVEL=all=info
MPV_STARTUP_TIMEOUT_SECONDS=5
MPV_EXTRA_ARGS=

# === NETWORK/BEHAVIOUR (moves to the config UI/store in Phase A) ===
CORS_ALLOW_ORIGINS=*
ENABLE_HTTPS_REDIRECT=false
PUBLIC_BASE_URL=

# === TIMEOUTS ===
HTTP_REQUEST_TIMEOUT=10