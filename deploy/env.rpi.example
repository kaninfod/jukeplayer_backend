# ============================================================================
# JUKEPLAYER BACKEND - RPi (dedicated device) environment — FINAL (Phase D)
# ============================================================================
# The config store (data/config.json, managed from the web UI) owns ALL user
# configuration: Subsonic, speakers, MPV, logging level, server behaviour.
# This file carries only the bootstrap/system keys the app reads from the
# environment — everything else was moved into the store at the Phase A
# cutover and is edited from /kiosk/config.
#
# The live file lives at <app dir>/.env (loaded by the systemd unit,
# deploy/jukeplayer.service → EnvironmentFile).

# === SYSTEM (bootstrap set — the only keys the app reads from the env) ===
LOG_SERVER_HOST=192.168.68.102
LOG_SERVER_PORT=514
LOG_LEVEL=INFO

# === Defaults (uncomment to override) ===
# CONFIG_FILE=data/config.json
# LOG_FILE=logs/jukebox.log
# STATIC_FILE_PATH=static_files
# ENABLE_DOCS=false
# DEBUG_MODE=false