# Jukeplayer backend — systemd unit (dedicated RPi, bare metal)
# Installed by scripts/setup_rpi.sh (paths adjusted to APP_DIR).
# Audio note: the service runs as a real user with XDG_RUNTIME_DIR pointed at
# that user's runtime dir, so mpv -> pulseaudio -> bluetooth works exactly like
# an interactive session (requires: loginctl enable-linger <user>).
# HTTP port: HTTP_PORT in .env overrides the default 8000 (e.g. 80 to omit
# the port from URLs — the bind capability below makes that work unprivileged).

[Unit]
Description=Jukeplayer backend (FastAPI + uvicorn)
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
User=__APP_USER__
Group=__APP_USER__
WorkingDirectory=__APP_DIR__
EnvironmentFile=__APP_DIR__/.env
Environment=XDG_RUNTIME_DIR=/run/user/__APP_UID__
# HTTP_PORT default 8000; EnvironmentFile (.env) values override Environment=
Environment=HTTP_PORT=8000
# Let the unprivileged service bind ports <1024 (HTTP_PORT=80); harmless otherwise
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
ExecStart=__APP_DIR__/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port ${HTTP_PORT}
Restart=on-failure
RestartSec=3

# Hardening (safe basics — the app talks to BT/audio via the user session)
NoNewPrivileges=true
ProtectHome=read-only
ReadWritePaths=__APP_DIR__

[Install]
WantedBy=multi-user.target